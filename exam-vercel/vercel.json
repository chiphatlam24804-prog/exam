{
  "functions": {
    "api/*.js": {
      "includeFiles": "public/data/answers.json",
      "maxDuration": 10
    }
  },
  "routes": [
    { "src": "/api/(.*)", "destination": "/api/$1" },
    { "src": "/assets/(.*)", "destination": "/public/assets/$1" },
    { "src": "/(.*)", "destination": "/index.html" }
  ]
}
